# Copy to .env.local (local dev) or add in your host's dashboard (e.g. Vercel → Settings → Environment Variables).

# Required: API key from https://resend.com/api-keys
RESEND_API_KEY=

# Where new inquiries are delivered. Defaults to quyum52526@gmail.com.
# Without a verified domain, Resend only delivers to the email you signed up to Resend with.
LEAD_TO_EMAIL=quyum52526@gmail.com

# Sender shown in your inbox. Keep the default until you verify your own domain in Resend,
# then use something like: Tech Bite BD <hello@yourdomain.com>
LEAD_FROM_EMAIL=Tech Bite BD Website <onboarding@resend.dev>
